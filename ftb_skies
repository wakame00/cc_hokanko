local TARGET_ORE = "ftbmaterials:dimensional_shard_stone_ore"

local IGNORE_BLOCKS = {
    ["minecraft:stone"] = true,        
    ["minecraft:cobblestone"] = true,  
    ["minecraft:deepslate"] = true,    
    ["minecraft:cobbled_deepslate"] = true, 
    ["minecraft:air"] = true,         
}

while true do
    local has_block, data = turtle.inspect()
    
    if has_block then
        if data.name == TARGET_ORE then
            print("win")
            turtle.dig() 
            
        elseif not IGNORE_BLOCKS[data.name] then
            turtle.dig()
        end
    end
    
    sleep(0.05)
end
