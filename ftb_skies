
local TARGET_ORE = "ftbmaterials:dimensional_shard_stone_ore"

local IGNORE_BLOCKS = {
    ["minecraft:stone"] = true,        -- 普通の石
    ["minecraft:cobblestone"] = true,  -- 丸石
    ["minecraft:deepslate"] = true,    -- 深層岩
    ["minecraft:cobbled_deepslate"] = true, -- 砕かれた深層岩
    ["minecraft:air"] = true,          -- 空気
}

while true do
    local has_block, data = turtle.inspect()
    
    if has_block then
        if data.name == TARGET_ORE then
            print("win")
            
        elseif not IGNORE_BLOCKS[data.name] then
            turtle.dig()
        end
        

    end
    
    sleep(0.05)
end
